# Copy to .env next to docker-compose.yml, then: docker compose up -d
#
#   cp deploy/.env.example .env

# Docker Hub repository holding the image.
IMAGE=gualix/sphero-tournament

# Image tag. Prefer a specific immutable tag over `latest` in production —
# every run of scripts/docker-build-push.sh publishes one (a git SHA, or
# the version passed as an argument). List what exists with:
#   curl -s https://hub.docker.com/v2/repositories/gualix/sphero-tournament/tags \
#     | python3 -c "import sys,json;[print(t['name']) for t in json.load(sys.stdin)['results']]"
TAG=latest

# Port on the host.
HOST_PORT=8080

# Interface to bind.
#   0.0.0.0    reachable directly at http://<server-ip>:8080
#   127.0.0.1  reachable only through a reverse proxy on the same host
# Use 127.0.0.1 whenever nginx sits in front, otherwise the app stays
# reachable unencrypted on HOST_PORT, bypassing TLS.
HOST_BIND=127.0.0.1

# Image platform. The published image is linux/amd64 only.
PLATFORM=linux/amd64
